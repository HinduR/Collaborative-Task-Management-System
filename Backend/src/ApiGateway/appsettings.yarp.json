{
  "GatewaySettings": {
    "RateLimiting": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "RequestTimeout": {
      "DefaultSeconds": 30
    }
  },

  "ReverseProxy": {
    "Routes": {
       "identity-google-callback": {
          "ClusterId": "identityCluster",
          "AuthorizationPolicy": "Anonymous",
          "Match": {
            "Path": "/signin-google"
          },
          "Transforms": [
            {
              "PathPattern": "/signin-google"
            }
          ]
        },
      "identity-auth": {
        "ClusterId": "identityCluster",
         "AuthorizationPolicy": "Anonymous",
        "Match": {
          "Path": "/api/identity/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/identity/auth/{**catch-all}"
          }
        ]
      },

      "identity": {
        "ClusterId": "identityCluster",
        "AuthorizationPolicy": "ApiTokenPolicy",
        "Match": {
          "Path": "/api/identity/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ]
        },
        "Transforms": [
          {
            "PathPattern": "/identity/{**catch-all}"
          }
        ]
      },

    "board-task-boards": {
        "ClusterId": "boardTaskCluster",
        "AuthorizationPolicy": "ApiTokenPolicy",
        "Match": {
          "Path": "/api/board-task/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ]
        },
        "Transforms": [
          {
            "PathPattern": "/board-task/{**catch-all}"
          }
        ]
      },

      "board-task-projects": {
        "ClusterId": "boardTaskCluster",
        "AuthorizationPolicy": "ApiTokenPolicy",
        "Match": {
          "Path": "/api/project/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ]
        },
        "Transforms": [
          {
            "PathPattern": "/project/{**catch-all}"
          }
        ]
      },

    "board-task-signalr": {
      "ClusterId": "boardTaskCluster",
      "AuthorizationPolicy": "ApiTokenPolicy",
      "TimeoutPolicy": "Disable",
      "RateLimiterPolicy": "Disable",
      "Match": {
        "Path": "/api/board-task/hubs/board/{**catch-all}"
      },
      "Transforms": [
        {
          "PathPattern": "/hubs/board/{**catch-all}"
        }
      ]
    },

    "board-task-signalr-root": {
      "ClusterId": "boardTaskCluster",
      "AuthorizationPolicy": "ApiTokenPolicy",
      "TimeoutPolicy": "Disable",
      "RateLimiterPolicy": "Disable",
      "Match": {
        "Path": "/api/board-task/hubs/board"
      },
      "Transforms": [
        {
          "PathPattern": "/hubs/board"
        }
      ]
    },

      "metadata": {
        "ClusterId": "metadataCluster",
        "AuthorizationPolicy": "ApiTokenPolicy",
        "Match": {
          "Path": "/api/meta-data/{**catch-all}",
          "Methods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ]
        },
        "Transforms": [
          {
            "PathPattern": "/meta-data/{**catch-all}"
          }
        ]
      }
    },

    "Clusters": {
      "identityCluster": {
         "HttpRequest": {
          "ActivityTimeout": "00:10:00"
        },
        "Destinations": {
          "identity": {
            "Address": "http://localhost:5039/"
          }
        }
      },

      "boardTaskCluster": {
         "HttpRequest": {
          "ActivityTimeout": "00:10:00"
        },
        "Destinations": {
          "board-task": {
            "Address": "http://localhost:5135/"
          }
        }
      },

      "metadataCluster": {
         "HttpRequest": {
          "ActivityTimeout": "00:10:00"
        },
        "Destinations": {
          "metadata": {
            "Address": "http://localhost:5278/"
          }
        }
      }
    }
  }
}